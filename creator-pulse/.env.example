# ---------------------------------------------------------------------------
# Database (Vercel Postgres / Neon). In Vercel this is injected automatically
# when you attach a Postgres store. Locally, paste the connection string here.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ---------------------------------------------------------------------------
# Secrets. Generate each with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
# Signs login cookies.
SESSION_SECRET=replace-with-openssl-rand-hex-32
# Encrypts stored OAuth tokens at rest (must be 64 hex chars = 32 bytes).
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# Shared password for the agency/admin view. Pick something and share it.
ADMIN_PASSWORD=change-me

# Public URL of the deployment, used to build OAuth redirect URIs.
# Local: http://localhost:3000   Vercel: https://your-app.vercel.app
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Instagram (Instagram API with Instagram Login) — developers.facebook.com
# Use the *Instagram* app id/secret, not the Facebook app credentials.
# ---------------------------------------------------------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---------------------------------------------------------------------------
# TikTok (Login Kit + Display API) — developers.tiktok.com
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
